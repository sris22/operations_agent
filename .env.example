APP_ENV=development
APP_NAME=ai-customer-operations-agent

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_customer_ops

# JWT Authentication
JWT_SECRET=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Embedding Provider
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Mock Enterprise API
ENTERPRISE_API_BASE_URL=http://mock-enterprise-api:8001

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG Configuration
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Business Rules
REFUND_APPROVAL_THRESHOLD=100.00

# Timeouts & Limits
LLM_TIMEOUT_SECONDS=60
EXTERNAL_API_TIMEOUT_SECONDS=30
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=10
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO

# Document Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=pdf,txt,md

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
